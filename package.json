{
  "name": "even-swarm",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sim": "evenhub-simulator http://localhost:5173",
    "dev:sim": "vite & sleep 1 && evenhub-simulator http://localhost:5173",
    "build": "tsc && vite build",
    "pack": "tsc && vite build --base=./ && evenhub pack app.json dist -o even-swarm.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@evenrealities/evenhub-simulator": "^0.7.3",
    "typescript": "~5.7.3",
    "vite": "^6.0.0"
  }
}
